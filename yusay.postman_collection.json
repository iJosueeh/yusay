    {
      "name": "01. Identidad & Autenticación (Auto-Token)",
      "item": [
        {
          "name": "1. Registro de Usuario (RF-001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.userId) {",
                  "        pm.collectionVariables.set('userId', data.userId);",
                  "        console.log('Usuario registrado con Id:', data.userId);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"adultConfirmed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registra una cuenta de usuario. En entorno de desarrollo o pruebas, el token de verificación puede obtenerse de logs o pruebas de integración."
          },
          "response": []
        },
        {
          "name": "2. Verificar Correo Electrónico (RF-001)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Verifica el correo electrónico para habilitar el inicio de sesión."
          },
          "response": []
        },
        {
          "name": "3. Iniciar Sesión [AUTO-TOKEN JWT] (RF-002)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.accessToken) {",
                  "        // Guardar token JWT automáticamente en las variables de la colección",
                  "        pm.collectionVariables.set('accessToken', data.accessToken);",
                  "        pm.collectionVariables.set('userId', data.userId);",
                  "        console.log('✓ Token JWT guardado automáticamente en {{accessToken}}');",
                  "        console.log('✓ Expira en:', data.expiresAt);",
                  "    } else {",
                  "        console.error('No se recibió accessToken en la respuesta.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sign-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-in"
              ]
            },
            "description": "Inicia sesión con credenciales válidas. El script de pruebas en JavaScript extrae automáticamente el accessToken y lo inyecta en la variable de colección {{accessToken}} para que todas las peticiones autenticadas lo utilicen sin intervención manual."
          },
          "response": []
        },
        {
          "name": "4. Consultar Perfil Autenticado (RF-004a)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta contiene exactamente los 6 campos normativos', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('userId');",
                  "    pm.expect(data).to.have.property('email');",
                  "    pm.expect(data).to.have.property('emailVerified');",
                  "    pm.expect(data).to.have.property('createdAt');",
                  "    pm.expect(data).to.have.property('adultConfirmedAt');",
                  "    pm.expect(data).to.have.property('status');",
                  "    // Comprobar ausencia de credenciales ni roles",
                  "    pm.expect(data).to.not.have.property('passwordHash');",
                  "    pm.expect(data).to.not.have.property('roles');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Obtiene los datos de perfil del usuario autenticado en modo solo lectura, utilizando automáticamente el token generado por el inicio de sesión."
          },
          "response": []
        },
        {
          "name": "5. Cerrar Sesión / Sign-Out (RF-002)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', '');",
                  "    console.log('✓ Token revocado y variable {{accessToken}} limpiada.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/sign-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-out"
              ]
            },
            "description": "Revoca el JTI del token en Redis e invalida la sesión del usuario."
          },
          "response": []
        },
        {
          "name": "6. Suprimir Cuenta de Usuario (RF-004b)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "if (pm.response.code === 204) {",
                  "    pm.collectionVariables.set('accessToken', '');",
                  "    console.log('✓ Cuenta eliminada físicamente y desvinculada de auditoría.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Elimina físicamente la cuenta de usuario tras validar la contraseña actual. Ejecuta la desvinculación a NULL de auditoría mediante trigger V021 e invalida el token en Redis."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Instrumentos & Evaluaciones",
      "item": [
        {
          "name": "1. Listar Instrumentos Disponibles (RF-005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.items && data.items.length > 0) {",
                  "        pm.collectionVariables.set('instrumentId', data.items[0].instrumentId);",
                  "        console.log('✓ Primer instrumentId guardado:', data.items[0].instrumentId);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ]
            },
            "description": "Lista los instrumentos publicados disponibles para evaluación."
          },
          "response": []
        },
        {
          "name": "2. Detalle de Instrumento (RF-005)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments/{{instrumentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments",
                "{{instrumentId}}"
              ]
            },
            "description": "Consulta el detalle y estructura del instrumento."
          },
          "response": []
        },
        {
          "name": "3. Iniciar Intento de Evaluación (RF-006)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.attemptId) {",
                  "        pm.collectionVariables.set('attemptId', data.attemptId);",
                  "        console.log('✓ Intento iniciado con Id:', data.attemptId);",
                  "    }",
                  "    if (data.questions && data.questions.length > 0) {",
                  "        const q = data.questions[0];",
                  "        pm.collectionVariables.set('questionId', q.questionId);",
                  "        if (q.options && q.options.length > 0) {",
                  "            pm.collectionVariables.set('optionId', q.options[0].optionId);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments/{{instrumentId}}/attempts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments",
                "{{instrumentId}}",
                "attempts"
              ]
            },
            "description": "Inicia un nuevo intento de evaluación en estado IN_PROGRESS. El script guarda automáticamente el attemptId, questionId y optionId para el siguiente paso."
          },
          "response": []
        },
        {
          "name": "4. Guardar Respuestas del Intento (RF-006 / RF-007)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{questionId}}\",\n      \"optionId\": \"{{optionId}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assessments/{{attemptId}}/answers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "{{attemptId}}",
                "answers"
              ]
            },
            "description": "Guarda de forma transaccional una o varias respuestas al intento de evaluación."
          },
          "response": []
        },
        {
          "name": "5. Consultar Progreso del Intento (RF-007)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assessments/{{attemptId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "{{attemptId}}"
              ]
            },
            "description": "Consulta el estado y progreso del intento de evaluación."
          },
          "response": []
        },
        {
          "name": "6. Enviar y Calcular Evaluación (RF-008)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    console.log('✓ Evaluación enviada con éxito. Score calculado:', data.result ? data.result.score : 'N/A');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assessments/{{attemptId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "{{attemptId}}",
                "submit"
              ]
            },
            "description": "Envía el intento, ejecuta el cálculo de puntaje atómico y resuelve la interpretación oficial correspondiente."
          },
          "response": []
        },
        {
          "name": "7. Consultar Orientación / Guidance (RF-018)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assessments/{{attemptId}}/guidance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments",
                "{{attemptId}}",
                "guidance"
              ]
            },
            "description": "Obtiene la orientación educativa compuesta del resultado oficial: interpretación, limitaciones, temas asociados, recursos y descargo no clínico."
          },
          "response": []
        },
        {
          "name": "8. Historial de Evaluaciones Propias (RF-009)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assessments?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assessments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Consulta el historial paginado de intentos de evaluación completados y en progreso del usuario."
          },
          "response": []
        }
      ]
    },
